# ==============================================================================
# Variáveis de ambiente — Blog Braziw
# Em desenvolvimento local, o app usa PGlite (.data/pglite) se DATABASE_URL estiver vazio.
# ==============================================================================

# Domínio base da aplicação (sem barra final)
SITE_URL=http://localhost:3100

# Chave secreta de sessão JWT (gere com: openssl rand -hex 32) - OBRIGATÓRIO em produção
AUTH_SECRET=

# Inteligência Artificial — Google Gemini (obtenha em https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# Banco de Dados Postgres (obrigatório na Vercel — use Neon, Supabase ou Vercel Postgres)
# Exemplo: postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Armazenamento de imagens em produção (Vercel Blob)
# Criado automaticamente ao adicionar "Blob" no painel da Vercel
BLOB_READ_WRITE_TOKEN=

# E-mail transacional (SMTP) para recuperação de senha e convites
# Se não configurado, o app roda em MODO DE TESTE e imprime os links de reset no terminal do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Blog Braziw <contato@braziw.com.br>"

# Dados do Administrador inicial (usados no script `npm run seed`)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@braziw.com.br
